#include <vector>

std::vector<int> compareTriplets(std::vector<int> a, std::vector<int> b) {
    int alice_score = 0;
    int bob_score = 0;

    for (int i = 0; i < 3; i++) {
        if (a[i] > b[i]) {
            alice_score++;
        } else if (a[i] < b[i]) {
            bob_score++;
        }
    }

    return {alice_score, bob_score};
}
