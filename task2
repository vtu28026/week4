import sys

def solve():
    input = sys.stdin.read
    data = input().split()
    
    if not data:
        return
    
    t = int(data[0])
    results = []
    
    for i in range(1, t + 1):
        s = data[i]
        n = len(s)
        
        # Determine the length of each half
        half_len = n // 2
        
        # Left half starts at index 0
        left_half = s[:half_len]
        
        # Right half starts after skipping the middle element if n is odd
        right_half = s[n - half_len:]
        
        # Compare sorted characters of both halves
        if sorted(left_half) == sorted(right_half):
            results.append("YES")
        else:
            results.append("NO")
            
    print('\n'.join(results))

if __name__ == '__main__':
    solve()
